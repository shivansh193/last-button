# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# The app must have "Payment Links & Buttons" enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Sandbox personal (buyer) account used by the verification bot.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Gemini (Google AI Studio) key for gap-filling reconstruction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the primary returns 429/503.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash

# Public base URL of this deployment (used for return URLs / webhooks).
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
